# STM32CubeMX / Keil project files
# Keep these tracked:
# *.ioc
# .mxproject
# *.uvprojx
# *.uvmpw
# *.sct
# *.ld
# startup_*.s
# *.jdebug

# Keil local packs, usually should not be committed
MDK-ARM/.pack/

# Keil / MDK-ARM build output directories
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/DebugConfig/
MDK-ARM/RTE/
MDK-ARM/ZLIC_2026/
MDK-ARM/ZLLC_2026/
MDK-ARM/output/
build/
Build/

# Keil / MDK generated files
*.o
*.obj
*.d
*.dep
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
