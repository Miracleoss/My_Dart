# Keil / MDK user-specific files
*.uvguix.*
*.uvgui.*
*.uvopt
*.uvoptx
*.Administrator
*.jdebug.user

# J-Link logs
JLinkLog.txt
MDK-ARM/JLinkLog.txt

# VSCode user-local files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/extensions.json

# OS and editor temporary files
.DS_Store
Thumbs.db
*.tmp
